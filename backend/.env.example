# Antardrishti configuration. Copy to backend/.env and fill in.
# .env is gitignored - never commit the real one.

# ---- Earth Engine -------------------------------------------------------
# Your Earth Engine Cloud project ID (code.earthengine.google.com -> profile).
EE_PROJECT_ID=
# On a server, run as a service account instead of a personal login
# (see DEPLOYMENT.md). Leave both empty on a laptop.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=

# ---- Language model (Groq API) ------------------------------------------
GROQ_API_KEY=
# REPORT_MODEL=openai/gpt-oss-120b
# TRANSLATE_MODEL=openai/gpt-oss-120b

# ---- Sign-in ------------------------------------------------------------
AUTH_REQUIRED=true
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, everyone is signed out whenever the server restarts.
SECRET_KEY=
SESSION_HOURS=12
# The first admin, created on first start only (ignored once any user exists).
# Remove the password from this file after first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Web ----------------------------------------------------------------
# Origins allowed to call the API from a browser. The built app is served by
# the API itself (same origin) and needs nothing here; these are for the
# Vite development server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when served over HTTPS behind a proxy that terminates TLS.
COOKIE_SECURE=false

# ---- Limits -------------------------------------------------------------
ANALYSES_PER_HOUR=60
# Anyone may create an account from the sign-up page (never admin).
# Set SIGNUP_ENABLED=false to make accounts admin-only.
SIGNUP_ENABLED=true
SIGNUPS_PER_HOUR=10
# Fetch satellite orbits and ESA's plans in the background at start-up.
SATELLITE_WARM=true
MAX_REQUEST_MB=25
MAX_UNZIPPED_MB=100
UPLOAD_RETENTION_DAYS=7
JOB_WORKERS=2

# ---- Data ---------------------------------------------------------------
# BOUNDARY_SET=2015          # measured: stay on 2015 (scripts/compare_boundaries.py)
# BOUNDARY_FALLBACK=2025     # names 2015 lacks (Telangana); "none" to disable
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# HINDI_FONT_PATH=C:\Windows\Fonts\Nirmala.ttc
LOG_FORMAT=json

# ---- Database ------------------------------------------------------------
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Without it
# everything is kept in data/app.db (SQLite), which is fine on one laptop.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=antardrishti

# Unsaved analyses are deleted after this many days; saved ones are kept.
RECENT_DAYS=7

# ---- Email (verification and password reset) -------------------------------
# Gmail: turn on 2-step verification, then Google Account -> Security ->
# App passwords, and paste the 16-character app password below. Without
# SMTP_HOST no email is sent (reset links go to the server log) and new
# accounts do not need to confirm their email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourproject@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM=Antardrishti <yourproject@gmail.com>
EMAIL_VERIFICATION=true
# The public address, used in emailed links (e.g. https://antardrishti.duckdns.org)
# APP_URL=
