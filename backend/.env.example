# Antardrishti configuration. Copy to backend/.env and fill in.
# .env is gitignored - never commit the real one.

# ---- Earth Engine -------------------------------------------------------
# Your Earth Engine Cloud project ID (code.earthengine.google.com -> profile).
EE_PROJECT_ID=
# On a server, run as a service account instead of a personal login
# (see DEPLOYMENT.md). Leave both empty on a laptop.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_FILE=

# ---- Language model (Groq API) ------------------------------------------
GROQ_API_KEY=
# REPORT_MODEL=openai/gpt-oss-120b
# TRANSLATE_MODEL=openai/gpt-oss-120b

# ---- Sign-in ------------------------------------------------------------
AUTH_REQUIRED=true
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, everyone is signed out whenever the server restarts.
SECRET_KEY=
SESSION_HOURS=12
# The first admin, created on first start only (ignored once any user exists).
# Remove the password from this file after first start.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Web ----------------------------------------------------------------
# Origins allowed to call the API from a browser. The built app is served by
# the API itself (same origin) and needs nothing here; these are for the
# Vite development server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when served over HTTPS behind a proxy that terminates TLS.
COOKIE_SECURE=false

# ---- Limits -------------------------------------------------------------
ANALYSES_PER_HOUR=60
MAX_REQUEST_MB=25
MAX_UNZIPPED_MB=100
UPLOAD_RETENTION_DAYS=7
JOB_WORKERS=2

# ---- Data ---------------------------------------------------------------
# BOUNDARY_SET=2015          # measured: stay on 2015 (scripts/compare_boundaries.py)
# BOUNDARY_FALLBACK=2025     # names 2015 lacks (Telangana); "none" to disable
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# HINDI_FONT_PATH=C:\Windows\Fonts\Nirmala.ttc
LOG_FORMAT=json
